{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2fleet.example/schemas/telemetry.enriched.json",
  "title": "telemetry.enriched",
  "description": "Validated telemetry enriched with route/depot lookup by telemetry-ingest. CloudEvents-ish envelope (SPEC.md \u00a73.3).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event id."
    },
    "type": {
      "const": "telemetry.enriched"
    },
    "source": {
      "type": "string",
      "description": "Emitting service name."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 emission time."
    },
    "data": {
      "type": "object",
      "properties": {
        "bus_id": {
          "type": "string",
          "format": "uuid"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "speed_kph": {
          "type": "number"
        },
        "h2_level_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fuel_cell_kw": {
          "type": "number"
        },
        "battery_soc_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "odometer_km": {
          "type": "number"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "route_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "depot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "heading_deg": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "bus_id",
        "ts",
        "speed_kph",
        "h2_level_pct",
        "fuel_cell_kw",
        "battery_soc_pct",
        "odometer_km",
        "lat",
        "lon"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source",
    "time",
    "data"
  ],
  "additionalProperties": false
}
