{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2fleet.example/schemas/station.status.changed.json",
  "title": "station.status.changed",
  "description": "Refueling station status/inventory change (refueling-stations). CloudEvents-ish envelope (SPEC.md §3.3).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event id."
    },
    "type": {
      "const": "station.status.changed"
    },
    "source": {
      "type": "string",
      "description": "Emitting service name."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 emission time."
    },
    "data": {
      "type": "object",
      "properties": {
        "station_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "online",
            "offline",
            "maintenance",
            "degraded"
          ]
        },
        "available_kg": {
          "type": "number"
        },
        "station_type": {
          "type": "string",
          "enum": ["h2", "ev_charger", "diesel", "cng", "mixed"],
          "description": "Wave-5 additive: station energy domain; defaults to 'h2' for existing stations."
        },
        "available_kwh": {
          "type": "number",
          "description": "Wave-5 additive: deliverable energy in kWh for ev_charger stations (available_kg stays the H2 inventory)."
        }
      },
      "required": [
        "station_id",
        "status",
        "available_kg"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source",
    "time",
    "data"
  ],
  "additionalProperties": false
}
