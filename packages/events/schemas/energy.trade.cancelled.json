{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2fleet.example/schemas/energy.trade.cancelled.json",
  "title": "energy.trade.cancelled",
  "description": "Proposed energy trade cancelled by an operator (only proposed trades are cancellable; no surplus was drawn and no settlement posted). CloudEvents-ish envelope (SPEC.md §3.3).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event id."
    },
    "type": {
      "const": "energy.trade.cancelled"
    },
    "source": {
      "type": "string",
      "description": "Emitting service name."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 emission time."
    },
    "data": {
      "type": "object",
      "properties": {
        "trade_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": ["h2-sale", "h2-purchase", "energy-export", "ev-v2g-export", "ev-charge-purchase"]
        },
        "quantity_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "price_minor": {
          "type": "integer",
          "minimum": 1
        },
        "cancelled_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trade_id",
        "kind",
        "quantity_kg",
        "price_minor",
        "cancelled_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source",
    "time",
    "data"
  ],
  "additionalProperties": false
}
