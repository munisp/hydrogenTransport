{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2fleet.example/schemas/fare.payment.failed.json",
  "title": "fare.payment.failed",
  "description": "Fare payment failed on Mojaloop rails (fare-payments). CloudEvents-ish envelope (SPEC.md §3.3).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event id."
    },
    "type": {
      "const": "fare.payment.failed"
    },
    "source": {
      "type": "string",
      "description": "Emitting service name."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 emission time."
    },
    "data": {
      "type": "object",
      "properties": {
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "rider_sub": {
          "type": "string"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "reason": {
          "type": "string",
          "description": "Machine-readable failure reason (e.g. payer_rejected, transfer_timeout, insufficient_funds)."
        }
      },
      "required": [
        "payment_id",
        "rider_sub",
        "amount_minor",
        "currency",
        "reason"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source",
    "time",
    "data"
  ],
  "additionalProperties": false
}
