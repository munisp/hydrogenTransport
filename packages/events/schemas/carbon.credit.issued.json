{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2fleet.example/schemas/carbon.credit.issued.json",
  "title": "carbon.credit.issued",
  "description": "CO2-avoidance credit issued for a period (carbon-credits). CloudEvents-ish envelope (SPEC.md \u00a73.3).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event id."
    },
    "type": {
      "const": "carbon.credit.issued"
    },
    "source": {
      "type": "string",
      "description": "Emitting service name."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 emission time."
    },
    "data": {
      "type": "object",
      "properties": {
        "credit_id": {
          "type": "string",
          "format": "uuid"
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "kg_co2_avoided": {
          "type": "number"
        },
        "credits": {
          "type": "number"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "credit_id",
        "period",
        "kg_co2_avoided",
        "credits",
        "issued_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source",
    "time",
    "data"
  ],
  "additionalProperties": false
}
