# APISIX gateway base (leave empty in dev — vite.config.ts proxies /api -> http://localhost:9080)
VITE_API_BASE=

# Keycloak OIDC (SPEC §3.5). When unreachable in dev, the app falls back to a mock
# platform-admin user so screens remain demoable.
VITE_KEYCLOAK_URL=http://localhost:8088
VITE_KEYCLOAK_REALM=h2fleet
VITE_KEYCLOAK_CLIENT_ID=h2fleet-pwa

# MapLibre style JSON (any OSM-compatible vector/raster style; GeoLibre in production)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Toggle polling interval (ms) — SPEC §3.2 says UI reacts to toggle changes
VITE_TOGGLE_POLL_MS=30000
