{
  "uid": "h2fleet-fleet",
  "title": "H2Fleet — Fleet",
  "description": "Telemetry pipeline rate and digital-twin freshness. Relies on the telemetry-ingest / digital-twin /metrics handlers (pending) and the twin_last_update_timestamp_seconds gauge.",
  "tags": ["h2fleet", "fleet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Telemetry messages (telemetry.raw, msg/s)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_consumer_records_consumed_total{service=\"telemetry-ingest\",topic=\"telemetry.raw\"}[5m])) or on() sum(rate(telemetry_ingest_messages_total[5m]))",
          "legendFormat": "msg/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Twin buses tracked",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(twin_last_update_timestamp_seconds) or on() twin_buses_tracked",
          "legendFormat": "buses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Twin stale buses (>2m)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count((time() - twin_last_update_timestamp_seconds) > 120)",
          "legendFormat": "stale"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Telemetry ingest rate by topic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_consumer_records_consumed_total{service=~\"telemetry-ingest|digital-twin\"}[5m])) or on() sum by (topic) (rate(telemetry_ingest_messages_total[5m]))",
          "legendFormat": "{{ topic }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Twin update age (s, max across buses)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - twin_last_update_timestamp_seconds)",
          "legendFormat": "max age"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
