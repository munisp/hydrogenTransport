# =============================================================================
# H2Fleet — environment template. Copy to `.env` (repo root) to override the
# dev defaults baked into infra/docker-compose.yml via ${VAR:-default}.
# The committed defaults are DEVELOPMENT-ONLY credentials; set real values for
# any shared environment. Full inventory + rotation notes: docs/SECRETS.md.
# =============================================================================

# --- Core data plane ---------------------------------------------------------
# Password for the main Postgres (user `h2`, db `h2fleet`). Also embedded in
# DATABASE_URL for every service and used by the backup + permify init jobs.
POSTGRES_PASSWORD=h2pass
# Password for Temporal's own Postgres (user `temporal`, db `temporal`).
TEMPORAL_POSTGRES_PASSWORD=temporal

# --- Identity (Keycloak) -----------------------------------------------------
# Admin console login (http://localhost:8180/admin).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Realm import secrets — rendered into infra/keycloak/realm-h2fleet.json by
# the keycloak-realm-init container at import time (sed substitution).
# Constraint: values must not contain `&`, `|` or newlines.
KEYCLOAK_SERVICES_CLIENT_SECRET=h2fleet-services-secret-change-me
KEYCLOAK_ADMIN_USER_PASSWORD=admin123
KEYCLOAK_OPERATOR_PASSWORD=operator123
KEYCLOAK_DRIVER_PASSWORD=driver123
KEYCLOAK_CITIZEN_PASSWORD=citizen123
# JWT audience validated by the Go services' auth middleware (checked only
# when set). Value = the confidential `services` client id from the realm;
# set to a dedicated resource-server client in prod.
KEYCLOAK_AUDIENCE=services

# --- Object storage (MinIO) --------------------------------------------------
MINIO_ROOT_USER=h2admin
MINIO_ROOT_PASSWORD=h2adminpass

# --- Gateway (APISIX) --------------------------------------------------------
# Admin API key (admin API is not host-published; used in-network).
APISIX_ADMIN_KEY=h2fleet-admin-key-change-me

# --- Machine ingest ----------------------------------------------------------
# Shared-secret bearer token for the H2 leak sensor ingest endpoint on
# infra-api (POST /v1/leaks/ingest). Rotate per sensor fleet in prod.
LEAK_INGEST_TOKEN=dev-leak-token-change-me

# --- Observability -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Backup ------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- Admin API (services/go/admin-api) ---------------------------------------
# Confidential Keycloak client admin-api uses to call the Keycloak Admin REST
# API (compose pins KEYCLOAK_ADMIN_URL=http://keycloak:8080). The client must
# exist in the h2fleet realm with a service account granted the needed
# realm-management roles — create it in the admin console
# (http://localhost:8180/admin) until the realm import ships it.
KEYCLOAK_ADMIN_CLIENT_ID=h2fleet-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=h2fleet-admin-api-secret-change-me
# DEV ONLY: when the two vars above are unset, admin-api refuses to start
# (identity path fails closed). H2_SIMULATED_KEYCLOAK=true opts into the
# simulated in-memory Keycloak admin client — no real users are provisioned.
# Never set this outside local development.
#H2_SIMULATED_KEYCLOAK=false

# --- Commerce (services/go/commerce-api) --------------------------------------
# Money paths fail closed by default: commerce-api requires TIGERBEETLE_ADDR
# (pinned to tigerbeetle:3000 in compose) and refuses to start without it.
# DEV ONLY opt-ins for running without the middleware stack:
#   H2_SIMULATED_LEDGER=true   in-memory dev ledger (fabricated balances,
#                              lost on restart); also enables the dev wallet
#                              top-up endpoint by default.
#   H2_SIMULATED_MOJALOOP=true use_mojaloop payments get clearly-labelled
#                              ml-simulated-* transfer ids instead of failing
#                              closed as mojaloop_unavailable.
# Never set either outside local development.
#H2_SIMULATED_LEDGER=false
#H2_SIMULATED_MOJALOOP=false
# Per-rider daily fare cap in minor units (cents). Once a rider's settled
# charges for the UTC day reach the cap, further rides settle at
# charged_minor=0. 0 disables capping.
#FARE_DAILY_CAP_MINOR=800
# Gates POST /v1/wallets/topup (dev wallet funding path). Defaults to true
# only with H2_SIMULATED_LEDGER=true; set explicitly to override.
#WALLET_TOPUP_ENABLED=

# --- Infrastructure (services/go/infra-api) -----------------------------------
# Optional interval (Go duration, e.g. "24h") for scheduled compliance report
# generation; manual POST /v1/compliance/reports/generate always works.
#COMPLIANCE_REPORT_INTERVAL=

# --- Open data portal ----------------------------------------------------------
# API key for the `data-partner` key-auth consumer on the open-data route.
# Prod: rendered into the APISIX consumer by apisix-etcd-sync; when unset the
# consumer is dropped (fail-closed, no partner access).
#H2_PARTNER_API_KEY=

# --- ML platform -------------------------------------------------------------
# MLflow tracking server (`make ml`, profiles ml/all):
#   UI            http://127.0.0.1:5000 (loopback only)
#   backend store dedicated `mlflow` database on the main Postgres
#               (auto-created by the mlflow-db-init one-shot — no extra secret,
#               uses POSTGRES_PASSWORD above)
#   artifacts     s3://lakehouse/mlflow on MinIO (bucket auto-created by
#               minio-init; credentials are MINIO_ROOT_USER/PASSWORD above)
# ml-platform (profile apps) talks to it via MLFLOW_TRACKING_URI, pinned to
# http://mlflow:5000 in compose; under the plain `apps` profile MLflow is not
# running, so tracking calls fail until `make ml` (or profile `all`) is up.
#
# Optional Neo4j graph features (`make graph`, profile graph). ml-platform gets
# NEO4J_URI=bolt://neo4j:7687 (+ NEO4J_USER=neo4j / NEO4J_PASSWORD) in compose.
# Browser: http://127.0.0.1:7474, bolt: 127.0.0.1:7687.
NEO4J_PASSWORD=neo4j-dev-pass-change-me

# --- Audit trail (insider-threat forensics) -----------------------------------
# Shared service-to-service ingest token for audit-log (:8086). Emitted by
# admin-api, toggle-service, commerce-api (AUDIT_LOG_URL is pinned to
# http://audit-log:8086 in compose). Required — compose refuses to start
# without it. Generate: openssl rand -hex 32
AUDIT_INGEST_TOKEN=change-me-openssl-rand-hex-32

# --- OCPP gateway (services/python/ocpp-gateway, :8100) -----------------------
# id_tag authorization for EV charge points (OCPP 1.6J Authorize). Comma-
# separated whitelist; id_tags matching a known bus (fleet.vehicles uuid or
# fleet_no) are always accepted. Default '*' = OPEN CHARGING (accept every
# id_tag, loud warning logged) — DEV ONLY, set an explicit list in production.
#OCPP_OPEN_ID_TAGS=DEPOT-CARD-1,DEPOT-CARD-2
# Heartbeat interval (seconds) returned in BootNotification responses.
#OCPP_BOOT_INTERVAL=300
# Unit of the charger meter register: wh (OCPP 1.6 default for
# Energy.Active.Import.Register) or kwh. charging_sessions.kwh is always kWh.
#OCPP_METER_UNIT=wh

# --- Carbon analytics (services/python/carbon-analytics, :8094) --------------
# Credit baseline methodology per vehicle energy_type (diesel-reference):
# battery buses are credited against the diesel baseline MINUS the grid
# electricity footprint of the energy consumed. Grid CO2 intensity (kg CO2
# per kWh); default 0.35 ≈ EU grid average — set your regional factor.
#GRID_CO2_KG_PER_KWH=0.35
# Fleet electricity consumption for battery buses (kWh per km) until per-bus
# learned kWh/km exists.
#EV_KWH_PER_KM=1.1
# CNG tailpipe factor vs the diesel reference (kg CO2 per km).
#CNG_KG_CO2_PER_KM=1.0
